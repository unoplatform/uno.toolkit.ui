<Project Sdk="Uno.Sdk.Private">
	<Import Project="..\..\tfm-common-winui.props" />

	<!--
	Adding project references to this project requires some manual adjustments.
	Please see https://github.com/unoplatform/uno/issues/3909 for more details.
	-->
	<PropertyGroup>
		<UnoSingleProject>true</UnoSingleProject>
		<DefineConstants>$(DefineConstants);IS_WINUI</DefineConstants>
		<AllowedOutputExtensionsInPackageBuildOutputFolder>.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
		<!-- Ensures the .xr.xml files are generated in a proper layout folder -->
		<GenerateLibraryLayout>true</GenerateLibraryLayout>
		<UnoFeatures>CSharpMarkup</UnoFeatures>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Uno.Toolkit.UI\Uno.Toolkit.WinUI.csproj" />
	</ItemGroup>

	<PropertyGroup>
		<PackageDescription>A set of C# for Markup helpers for Uno.Toolkit.WinUI</PackageDescription>
	</PropertyGroup>

	<ItemGroup Condition="'$(ImplicitUsings)'=='true' OR '$(ImplicitUsings)'=='enable'">
		<Using Include="Uno.Toolkit.UI.Markup" />
	</ItemGroup>

	<!--
	Workarounds for Uno.Extensions.Markup.Generators bugs with an attached property of type DataTemplate (Skeleton.PlaceholderTemplate):
	its DataTemplate overloads cast to DataTemplateSelector without importing that namespace, and skip the null check
	on the target element that its other overloads have (CS8602). Remove both once the generator is fixed.
	-->
	<PropertyGroup>
		<NoWarn>$(NoWarn);CS8602</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<Using Include="Microsoft.UI.Xaml.Controls.DataTemplateSelector" Alias="DataTemplateSelector" />
	</ItemGroup>

	<Import Project="..\..\winappsdk-workaround.targets" />
</Project>
