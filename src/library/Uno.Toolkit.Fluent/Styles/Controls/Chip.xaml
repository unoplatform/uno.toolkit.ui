<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:utu="using:Uno.Toolkit.UI">

	<!--
		Fluent uses compact, subtly outlined tokens; elevated semantic variants
		retain this treatment instead of introducing Material elevation.
	-->
	<x:Double x:Key="FluentChipMinHeight">32</x:Double>
	<x:Double x:Key="FluentChipIconSize">16</x:Double>
	<Thickness x:Key="FluentChipPadding">8,4</Thickness>
	<Thickness x:Key="FluentChipContentMargin">4,0</Thickness>
	<Thickness x:Key="FluentChipBorderThickness">1</Thickness>

	<Style x:Key="FluentChipRemoveButtonStyle"
		   BasedOn="{StaticResource DefaultButtonStyle}"
		   TargetType="Button">
		<Setter Property="MinWidth" Value="24" />
		<Setter Property="MinHeight" Value="24" />
		<Setter Property="Padding" Value="4" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="AutomationProperties.Name" Value="Remove" />
		<Setter Property="Content">
			<Setter.Value>
				<SymbolIcon Symbol="Cancel" />
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="FluentChipStyle"
		   TargetType="utu:Chip">
		<Setter Property="MinHeight" Value="{ThemeResource FluentChipMinHeight}" />
		<Setter Property="Padding" Value="{ThemeResource FluentChipPadding}" />
		<Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
		<Setter Property="BorderThickness" Value="{ThemeResource FluentChipBorderThickness}" />
		<Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
		<Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
		<Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
		<Setter Property="FontFamily" Value="{ThemeResource BodyMediumFontFamily}" />
		<Setter Property="FontSize" Value="{ThemeResource BodyMediumFontSize}" />
		<Setter Property="FontWeight" Value="{ThemeResource BodyMediumFontWeight}" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="UseSystemFocusVisuals" Value="True" />
		<Setter Property="Elevation" Value="0" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="utu:Chip">
					<Grid x:Name="Root"
						  Padding="{TemplateBinding Padding}"
						  Background="{TemplateBinding Background}"
						  BorderBrush="{TemplateBinding BorderBrush}"
						  BorderThickness="{TemplateBinding BorderThickness}"
						  CornerRadius="{TemplateBinding CornerRadius}"
						  Control.IsTemplateFocusTarget="True">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="Root.Background" Value="{ThemeResource SurfaceVariantBrush}" />


									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Pressed">
									<VisualState.Setters>
										<Setter Target="Root.Opacity" Value="0.8" />
										<Setter Target="Root.Background" Value="{ThemeResource SurfaceVariantBrush}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
										<Setter Target="IconPresenter.Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
										<Setter Target="PART_RemoveButton.Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />

									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Disabled">
									<VisualState.Setters>
										<Setter Target="Root.Background" Value="{ThemeResource SurfaceBrush}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
										<Setter Target="IconPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
										<Setter Target="PART_RemoveButton.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
										<Setter Target="Root.BorderBrush" Value="{ThemeResource OutlineDisabledBrush}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Checked">
									<VisualState.Setters>
										<Setter Target="Root.Background" Value="{ThemeResource PrimaryBrush}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OnPrimaryBrush}" />
										<Setter Target="IconPresenter.Foreground" Value="{ThemeResource OnPrimaryBrush}" />
										<Setter Target="PART_RemoveButton.Foreground" Value="{ThemeResource OnPrimaryBrush}" />

									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="CheckedPointerOver">
									<VisualState.Setters>
										<Setter Target="Root.Opacity" Value="0.9" />
										<Setter Target="Root.Background" Value="{ThemeResource PrimaryBrush}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OnPrimaryBrush}" />
										<Setter Target="IconPresenter.Foreground" Value="{ThemeResource OnPrimaryBrush}" />
										<Setter Target="PART_RemoveButton.Foreground" Value="{ThemeResource OnPrimaryBrush}" />

									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="CheckedPressed">
									<VisualState.Setters>
										<Setter Target="Root.Opacity" Value="0.8" />
										<Setter Target="Root.Background" Value="{ThemeResource PrimaryBrush}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OnPrimaryBrush}" />
										<Setter Target="IconPresenter.Foreground" Value="{ThemeResource OnPrimaryBrush}" />
										<Setter Target="PART_RemoveButton.Foreground" Value="{ThemeResource OnPrimaryBrush}" />

									</VisualState.Setters>
								</VisualState>

								<VisualState x:Name="CheckedDisabled">
									<VisualState.Setters>
										<Setter Target="Root.Background" Value="{ThemeResource SurfaceBrush}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
										<Setter Target="IconPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
										<Setter Target="PART_RemoveButton.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
										<Setter Target="Root.BorderBrush" Value="{ThemeResource OutlineDisabledBrush}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Indeterminate">
									<VisualState.Setters>
										<Setter Target="Root.Background" Value="{ThemeResource PrimaryContainerBrush}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OnPrimaryContainerBrush}" />
										<Setter Target="IconPresenter.Foreground" Value="{ThemeResource OnPrimaryContainerBrush}" />
										<Setter Target="PART_RemoveButton.Foreground" Value="{ThemeResource OnPrimaryContainerBrush}" />

									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="IndeterminatePointerOver">
									<VisualState.Setters>
										<Setter Target="Root.Background" Value="{ThemeResource PrimaryContainerBrush}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OnPrimaryContainerBrush}" />
										<Setter Target="IconPresenter.Foreground" Value="{ThemeResource OnPrimaryContainerBrush}" />
										<Setter Target="PART_RemoveButton.Foreground" Value="{ThemeResource OnPrimaryContainerBrush}" />

									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="IndeterminatePressed">
									<VisualState.Setters>
										<Setter Target="Root.Background" Value="{ThemeResource PrimaryContainerBrush}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OnPrimaryContainerBrush}" />
										<Setter Target="IconPresenter.Foreground" Value="{ThemeResource OnPrimaryContainerBrush}" />
										<Setter Target="PART_RemoveButton.Foreground" Value="{ThemeResource OnPrimaryContainerBrush}" />

									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="IndeterminateDisabled">
									<VisualState.Setters>
										<Setter Target="Root.Background" Value="{ThemeResource SurfaceBrush}" />
										<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
										<Setter Target="IconPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
										<Setter Target="PART_RemoveButton.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
										<Setter Target="Root.BorderBrush" Value="{ThemeResource OutlineDisabledBrush}" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
						<ContentPresenter x:Name="IconPresenter"
										  Width="{ThemeResource FluentChipIconSize}"
										  Height="{ThemeResource FluentChipIconSize}"
										  VerticalAlignment="Center"
										  Content="{TemplateBinding Icon}"
										  ContentTemplate="{TemplateBinding IconTemplate}"
										  Foreground="{TemplateBinding Foreground}"
										  Visibility="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToCollapsedConverter}}" />
						<ContentPresenter x:Name="ContentPresenter"
										  Grid.Column="1"
										  Margin="{ThemeResource FluentChipContentMargin}"
										  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
										  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
										  Content="{TemplateBinding Content}"
										  ContentTemplate="{TemplateBinding ContentTemplate}"
										  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
										  ContentTransitions="{TemplateBinding ContentTransitions}"
										  FontFamily="{TemplateBinding FontFamily}"
										  FontSize="{TemplateBinding FontSize}"
										  FontWeight="{TemplateBinding FontWeight}"
										  Foreground="{TemplateBinding Foreground}" />
						<Button x:Name="PART_RemoveButton"
								Grid.Column="2"
								VerticalAlignment="Center"
								Foreground="{TemplateBinding Foreground}"
								Style="{StaticResource FluentChipRemoveButtonStyle}"
								Visibility="{Binding CanRemove, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource FalseToCollapsedConverter}}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="FluentInputChipStyle"
		   BasedOn="{StaticResource FluentChipStyle}"
		   TargetType="utu:Chip">
		<Setter Property="CanRemove" Value="True" />
	</Style>
	<Style x:Key="FluentAssistChipStyle"
		   BasedOn="{StaticResource FluentChipStyle}"
		   TargetType="utu:Chip" />
	<Style x:Key="FluentElevatedAssistChipStyle"
		   BasedOn="{StaticResource FluentAssistChipStyle}"
		   TargetType="utu:Chip" />
	<Style x:Key="FluentFilterChipStyle"
		   BasedOn="{StaticResource FluentChipStyle}"
		   TargetType="utu:Chip" />
	<Style x:Key="FluentElevatedFilterChipStyle"
		   BasedOn="{StaticResource FluentFilterChipStyle}"
		   TargetType="utu:Chip" />
	<Style x:Key="FluentSuggestionChipStyle"
		   BasedOn="{StaticResource FluentChipStyle}"
		   TargetType="utu:Chip" />
	<Style x:Key="FluentElevatedSuggestionChipStyle"
		   BasedOn="{StaticResource FluentSuggestionChipStyle}"
		   TargetType="utu:Chip" />

	<!--
		A separate template preserves error roles in every interaction state without
		replacing consumer resources or adding palette properties to Chip.
	-->
	<ControlTemplate x:Key="FluentDangerChipTemplate"
					 TargetType="utu:Chip">
		<Grid x:Name="Root"
			  Padding="{TemplateBinding Padding}"
			  Background="{TemplateBinding Background}"
			  BorderBrush="{TemplateBinding BorderBrush}"
			  BorderThickness="{TemplateBinding BorderThickness}"
			  CornerRadius="{TemplateBinding CornerRadius}"
			  Control.IsTemplateFocusTarget="True">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<VisualStateManager.VisualStateGroups>
				<VisualStateGroup x:Name="CommonStates">
					<VisualState x:Name="Normal" />
					<VisualState x:Name="PointerOver">
						<VisualState.Setters>
							<Setter Target="Root.Background" Value="{ThemeResource SurfaceVariantBrush}" />


						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="Pressed">
						<VisualState.Setters>
							<Setter Target="Root.Opacity" Value="0.8" />
							<Setter Target="Root.Background" Value="{ThemeResource SurfaceVariantBrush}" />
							<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ErrorBrush}" />
							<Setter Target="IconPresenter.Foreground" Value="{ThemeResource ErrorBrush}" />
							<Setter Target="PART_RemoveButton.Foreground" Value="{ThemeResource ErrorBrush}" />

						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="Disabled">
						<VisualState.Setters>
							<Setter Target="Root.Background" Value="{ThemeResource SurfaceBrush}" />
							<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
							<Setter Target="IconPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
							<Setter Target="PART_RemoveButton.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
							<Setter Target="Root.BorderBrush" Value="{ThemeResource OutlineDisabledBrush}" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="Checked">
						<VisualState.Setters>
							<Setter Target="Root.Background" Value="{ThemeResource ErrorBrush}" />
							<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OnErrorBrush}" />
							<Setter Target="IconPresenter.Foreground" Value="{ThemeResource OnErrorBrush}" />
							<Setter Target="PART_RemoveButton.Foreground" Value="{ThemeResource OnErrorBrush}" />

						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="CheckedPointerOver">
						<VisualState.Setters>
							<Setter Target="Root.Opacity" Value="0.9" />
							<Setter Target="Root.Background" Value="{ThemeResource ErrorBrush}" />
							<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OnErrorBrush}" />
							<Setter Target="IconPresenter.Foreground" Value="{ThemeResource OnErrorBrush}" />
							<Setter Target="PART_RemoveButton.Foreground" Value="{ThemeResource OnErrorBrush}" />

						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="CheckedPressed">
						<VisualState.Setters>
							<Setter Target="Root.Opacity" Value="0.8" />
							<Setter Target="Root.Background" Value="{ThemeResource ErrorBrush}" />
							<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OnErrorBrush}" />
							<Setter Target="IconPresenter.Foreground" Value="{ThemeResource OnErrorBrush}" />
							<Setter Target="PART_RemoveButton.Foreground" Value="{ThemeResource OnErrorBrush}" />

						</VisualState.Setters>
					</VisualState>

					<VisualState x:Name="CheckedDisabled">
						<VisualState.Setters>
							<Setter Target="Root.Background" Value="{ThemeResource SurfaceBrush}" />
							<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
							<Setter Target="IconPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
							<Setter Target="PART_RemoveButton.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
							<Setter Target="Root.BorderBrush" Value="{ThemeResource OutlineDisabledBrush}" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="Indeterminate">
						<VisualState.Setters>
							<Setter Target="Root.Background" Value="{ThemeResource ErrorContainerBrush}" />
							<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OnErrorContainerBrush}" />
							<Setter Target="IconPresenter.Foreground" Value="{ThemeResource OnErrorContainerBrush}" />
							<Setter Target="PART_RemoveButton.Foreground" Value="{ThemeResource OnErrorContainerBrush}" />

						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="IndeterminatePointerOver">
						<VisualState.Setters>
							<Setter Target="Root.Background" Value="{ThemeResource ErrorContainerBrush}" />
							<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OnErrorContainerBrush}" />
							<Setter Target="IconPresenter.Foreground" Value="{ThemeResource OnErrorContainerBrush}" />
							<Setter Target="PART_RemoveButton.Foreground" Value="{ThemeResource OnErrorContainerBrush}" />

						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="IndeterminatePressed">
						<VisualState.Setters>
							<Setter Target="Root.Background" Value="{ThemeResource ErrorContainerBrush}" />
							<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OnErrorContainerBrush}" />
							<Setter Target="IconPresenter.Foreground" Value="{ThemeResource OnErrorContainerBrush}" />
							<Setter Target="PART_RemoveButton.Foreground" Value="{ThemeResource OnErrorContainerBrush}" />

						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="IndeterminateDisabled">
						<VisualState.Setters>
							<Setter Target="Root.Background" Value="{ThemeResource SurfaceBrush}" />
							<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
							<Setter Target="IconPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
							<Setter Target="PART_RemoveButton.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
							<Setter Target="Root.BorderBrush" Value="{ThemeResource OutlineDisabledBrush}" />
						</VisualState.Setters>
					</VisualState>
				</VisualStateGroup>
			</VisualStateManager.VisualStateGroups>
			<ContentPresenter x:Name="IconPresenter"
							  Width="{ThemeResource FluentChipIconSize}"
							  Height="{ThemeResource FluentChipIconSize}"
							  VerticalAlignment="Center"
							  Content="{TemplateBinding Icon}"
							  ContentTemplate="{TemplateBinding IconTemplate}"
							  Foreground="{TemplateBinding Foreground}"
							  Visibility="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NullToCollapsedConverter}}" />
			<ContentPresenter x:Name="ContentPresenter"
							  Grid.Column="1"
							  Margin="{ThemeResource FluentChipContentMargin}"
							  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							  Content="{TemplateBinding Content}"
							  ContentTemplate="{TemplateBinding ContentTemplate}"
							  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
							  ContentTransitions="{TemplateBinding ContentTransitions}"
							  FontFamily="{TemplateBinding FontFamily}"
							  FontSize="{TemplateBinding FontSize}"
							  FontWeight="{TemplateBinding FontWeight}"
							  Foreground="{TemplateBinding Foreground}" />
			<Button x:Name="PART_RemoveButton"
					Grid.Column="2"
					VerticalAlignment="Center"
					Foreground="{TemplateBinding Foreground}"
					Style="{StaticResource FluentChipRemoveButtonStyle}"
					Visibility="{Binding CanRemove, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource FalseToCollapsedConverter}}" />
		</Grid>
	</ControlTemplate>


	<Style x:Key="FluentDangerChipStyle"
		   BasedOn="{StaticResource FluentChipStyle}"
		   TargetType="utu:Chip">
		<Setter Property="Foreground" Value="{ThemeResource ErrorBrush}" />
		<Setter Property="BorderBrush" Value="{ThemeResource ErrorBrush}" />
		<Setter Property="Template" Value="{StaticResource FluentDangerChipTemplate}" />
	</Style>
	<Style x:Key="FluentDefaultChipStyle"
		   BasedOn="{StaticResource FluentChipStyle}"
		   TargetType="utu:Chip" />
</ResourceDictionary>
