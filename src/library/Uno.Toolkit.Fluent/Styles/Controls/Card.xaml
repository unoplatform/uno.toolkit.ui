<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:toolkit="using:Uno.UI.Toolkit"
					xmlns:utu="using:Uno.Toolkit.UI">

	<!-- Shape and spacing follow the Fluent theme scales; the default inset is 16px. -->
	<Thickness x:Key="FluentCardBorderThickness">1</Thickness>
	<x:Double x:Key="FluentCardElevation">4</x:Double>
	<x:Double x:Key="FluentCardPointerOverOpacity">0.04</x:Double>
	<x:Double x:Key="FluentCardPressedOpacity">0.08</x:Double>

	<DataTemplate x:Key="FluentDefaultMediaContentTemplate">
		<Border MinHeight="160"
				CornerRadius="{ThemeResource ControlCornerRadius}">
			<Image Source="{Binding}"
				   Stretch="UniformToFill" />
		</Border>
	</DataTemplate>
	<DataTemplate x:Key="FluentDefaultAvatarContentTemplate">
		<PersonPicture Width="40"
					   Height="40"
					   ProfilePicture="{Binding}" />
	</DataTemplate>
	<DataTemplate x:Key="FluentDefaultSmallMediaContentTemplate">
		<Border Width="80"
				Height="80"
				CornerRadius="{ThemeResource ControlCornerRadius}">
			<Image Source="{Binding}"
				   Stretch="UniformToFill" />
		</Border>
	</DataTemplate>

	<ControlTemplate x:Key="FluentStandardCardTemplate"
					 TargetType="utu:Card">
		<Grid>
			<VisualStateManager.VisualStateGroups>
				<VisualStateGroup x:Name="CommonStates">
					<VisualState x:Name="Normal" />
					<VisualState x:Name="PointerOver">
						<VisualState.Setters>
							<Setter Target="InteractionOverlay.Opacity" Value="{StaticResource FluentCardPointerOverOpacity}" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="Pressed">
						<VisualState.Setters>
							<Setter Target="InteractionOverlay.Opacity" Value="{StaticResource FluentCardPressedOpacity}" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="Disabled">
						<VisualState.Setters>
							<Setter Target="ElevatedRoot.Background" Value="{ThemeResource SurfaceVariantBrush}" />
							<Setter Target="HeaderContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
							<Setter Target="SubHeaderContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
							<Setter Target="SupportingContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
							<Setter Target="IconsContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
							<Setter Target="AvatarContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
							<Setter Target="MediaContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
						</VisualState.Setters>
					</VisualState>
				</VisualStateGroup>
				<VisualStateGroup x:Name="FocusStates">
					<VisualState x:Name="Focused" />
					<VisualState x:Name="PointerFocused" />
					<VisualState x:Name="Unfocused" />
				</VisualStateGroup>
			</VisualStateManager.VisualStateGroups>

			<toolkit:ElevatedView x:Name="ElevatedRoot"
								  Background="{TemplateBinding Background}"
								  CornerRadius="{TemplateBinding CornerRadius}"
								  Elevation="{TemplateBinding Elevation}"
								  ShadowColor="{TemplateBinding ShadowColor}">
				<Grid BorderBrush="{TemplateBinding BorderBrush}"
					  BorderThickness="{TemplateBinding BorderThickness}"
					  CornerRadius="{TemplateBinding CornerRadius}">
					<Border x:Name="InteractionOverlay"
							Background="{TemplateBinding Foreground}"
							CornerRadius="{TemplateBinding CornerRadius}"
							IsHitTestVisible="False"
							Opacity="0" />
					<Grid Padding="{TemplateBinding Padding}">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<ContentPresenter x:Name="MediaContentPresenter"
										  Grid.Row="0"
										  Margin="{ThemeResource Space300BottomThickness}"
										  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										  Content="{TemplateBinding MediaContent}"
										  ContentTemplate="{TemplateBinding MediaContentTemplate}"
										  Foreground="{TemplateBinding Foreground}"
										  Visibility="{Binding MediaContent, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyOrNullToCollapsedConverter}}" />
						<ContentPresenter x:Name="AvatarContentPresenter"
										  Grid.Row="1"
										  Margin="{ThemeResource Space300BottomThickness}"
										  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										  Content="{TemplateBinding AvatarContent}"
										  ContentTemplate="{TemplateBinding AvatarContentTemplate}"
										  Foreground="{TemplateBinding Foreground}"
										  Visibility="{Binding AvatarContent, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyOrNullToCollapsedConverter}}" />
						<ContentPresenter x:Name="HeaderContentPresenter"
										  Grid.Row="2"
										  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										  FontFamily="{ThemeResource TitleMediumFontFamily}"
										  FontSize="{ThemeResource TitleMediumFontSize}"
										  FontWeight="{ThemeResource TitleMediumFontWeight}"
										  Content="{TemplateBinding HeaderContent}"
										  ContentTemplate="{TemplateBinding HeaderContentTemplate}"
										  Foreground="{TemplateBinding Foreground}"
										  Visibility="{Binding HeaderContent, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyOrNullToCollapsedConverter}}" />
						<ContentPresenter x:Name="SubHeaderContentPresenter"
										  Grid.Row="3"
										  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										  FontFamily="{ThemeResource BodyMediumFontFamily}"
										  FontSize="{ThemeResource BodyMediumFontSize}"
										  FontWeight="{ThemeResource BodyMediumFontWeight}"
										  Content="{TemplateBinding SubHeaderContent}"
										  ContentTemplate="{TemplateBinding SubHeaderContentTemplate}"
										  Foreground="{TemplateBinding Foreground}"
										  Visibility="{Binding SubHeaderContent, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyOrNullToCollapsedConverter}}" />
						<ContentPresenter x:Name="SupportingContentPresenter"
										  Grid.Row="4"
										  Margin="{ThemeResource Space300TopThickness}"
										  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										  FontFamily="{ThemeResource BodyMediumFontFamily}"
										  FontSize="{ThemeResource BodyMediumFontSize}"
										  FontWeight="{ThemeResource BodyMediumFontWeight}"
										  Content="{TemplateBinding SupportingContent}"
										  ContentTemplate="{TemplateBinding SupportingContentTemplate}"
										  Foreground="{TemplateBinding Foreground}"
										  Visibility="{Binding SupportingContent, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyOrNullToCollapsedConverter}}" />
						<ContentPresenter x:Name="IconsContentPresenter"
										  Grid.Row="5"
										  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										  Content="{TemplateBinding IconsContent}"
										  ContentTemplate="{TemplateBinding IconsContentTemplate}"
										  Foreground="{TemplateBinding Foreground}" />
					</Grid>
				</Grid>
			</toolkit:ElevatedView>
		</Grid>
	</ControlTemplate>

	<ControlTemplate x:Key="FluentAvatarCardTemplate"
					 TargetType="utu:Card">
		<Grid>
			<VisualStateManager.VisualStateGroups>
				<VisualStateGroup x:Name="CommonStates">
					<VisualState x:Name="Normal" />
					<VisualState x:Name="PointerOver">
						<VisualState.Setters>
							<Setter Target="InteractionOverlay.Opacity" Value="{StaticResource FluentCardPointerOverOpacity}" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="Pressed">
						<VisualState.Setters>
							<Setter Target="InteractionOverlay.Opacity" Value="{StaticResource FluentCardPressedOpacity}" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="Disabled">
						<VisualState.Setters>
							<Setter Target="ElevatedRoot.Background" Value="{ThemeResource SurfaceVariantBrush}" />
							<Setter Target="HeaderContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
							<Setter Target="SubHeaderContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
							<Setter Target="SupportingContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
							<Setter Target="IconsContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
							<Setter Target="AvatarContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
							<Setter Target="MediaContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
						</VisualState.Setters>
					</VisualState>
				</VisualStateGroup>
				<VisualStateGroup x:Name="FocusStates">
					<VisualState x:Name="Focused" />
					<VisualState x:Name="PointerFocused" />
					<VisualState x:Name="Unfocused" />
				</VisualStateGroup>
			</VisualStateManager.VisualStateGroups>

			<toolkit:ElevatedView x:Name="ElevatedRoot"
								  Background="{TemplateBinding Background}"
								  CornerRadius="{TemplateBinding CornerRadius}"
								  Elevation="{TemplateBinding Elevation}"
								  ShadowColor="{TemplateBinding ShadowColor}">
				<Grid BorderBrush="{TemplateBinding BorderBrush}"
					  BorderThickness="{TemplateBinding BorderThickness}"
					  CornerRadius="{TemplateBinding CornerRadius}">
					<Border x:Name="InteractionOverlay"
							Background="{TemplateBinding Foreground}"
							CornerRadius="{TemplateBinding CornerRadius}"
							IsHitTestVisible="False"
							Opacity="0" />
					<Grid Padding="{TemplateBinding Padding}">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<ContentPresenter x:Name="AvatarContentPresenter"
										  Grid.Row="0"
										  Grid.RowSpan="2"
										  Margin="{ThemeResource Space300RightThickness}"
										  VerticalAlignment="Center"
										  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										  Content="{TemplateBinding AvatarContent}"
										  ContentTemplate="{TemplateBinding AvatarContentTemplate}"
										  Foreground="{TemplateBinding Foreground}"
										  Visibility="{Binding AvatarContent, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyOrNullToCollapsedConverter}}" />
						<ContentPresenter x:Name="HeaderContentPresenter"
										  Grid.Row="0"
										  Grid.Column="1"
										  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										  FontFamily="{ThemeResource TitleMediumFontFamily}"
										  FontSize="{ThemeResource TitleMediumFontSize}"
										  FontWeight="{ThemeResource TitleMediumFontWeight}"
										  Content="{TemplateBinding HeaderContent}"
										  ContentTemplate="{TemplateBinding HeaderContentTemplate}"
										  Foreground="{TemplateBinding Foreground}"
										  Visibility="{Binding HeaderContent, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyOrNullToCollapsedConverter}}" />
						<ContentPresenter x:Name="SubHeaderContentPresenter"
										  Grid.Row="1"
										  Grid.Column="1"
										  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										  FontFamily="{ThemeResource BodyMediumFontFamily}"
										  FontSize="{ThemeResource BodyMediumFontSize}"
										  FontWeight="{ThemeResource BodyMediumFontWeight}"
										  Content="{TemplateBinding SubHeaderContent}"
										  ContentTemplate="{TemplateBinding SubHeaderContentTemplate}"
										  Foreground="{TemplateBinding Foreground}"
										  Visibility="{Binding SubHeaderContent, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyOrNullToCollapsedConverter}}" />
						<ContentPresenter x:Name="MediaContentPresenter"
										  Grid.Row="2"
										  Grid.ColumnSpan="2"
										  Margin="{ThemeResource Space300TopThickness}"
										  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										  Content="{TemplateBinding MediaContent}"
										  ContentTemplate="{TemplateBinding MediaContentTemplate}"
										  Foreground="{TemplateBinding Foreground}"
										  Visibility="{Binding MediaContent, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyOrNullToCollapsedConverter}}" />
						<ContentPresenter x:Name="SupportingContentPresenter"
										  Grid.Row="3"
										  Grid.ColumnSpan="2"
										  Margin="{ThemeResource Space300TopThickness}"
										  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										  FontFamily="{ThemeResource BodyMediumFontFamily}"
										  FontSize="{ThemeResource BodyMediumFontSize}"
										  FontWeight="{ThemeResource BodyMediumFontWeight}"
										  Content="{TemplateBinding SupportingContent}"
										  ContentTemplate="{TemplateBinding SupportingContentTemplate}"
										  Foreground="{TemplateBinding Foreground}"
										  Visibility="{Binding SupportingContent, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyOrNullToCollapsedConverter}}" />
						<ContentPresenter x:Name="IconsContentPresenter"
										  Grid.Row="4"
										  Grid.ColumnSpan="2"
										  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										  Content="{TemplateBinding IconsContent}"
										  ContentTemplate="{TemplateBinding IconsContentTemplate}"
										  Foreground="{TemplateBinding Foreground}" />
					</Grid>
				</Grid>
			</toolkit:ElevatedView>
		</Grid>
	</ControlTemplate>

	<ControlTemplate x:Key="FluentSmallMediaCardTemplate"
					 TargetType="utu:Card">
		<Grid>
			<VisualStateManager.VisualStateGroups>
				<VisualStateGroup x:Name="CommonStates">
					<VisualState x:Name="Normal" />
					<VisualState x:Name="PointerOver">
						<VisualState.Setters>
							<Setter Target="InteractionOverlay.Opacity" Value="{StaticResource FluentCardPointerOverOpacity}" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="Pressed">
						<VisualState.Setters>
							<Setter Target="InteractionOverlay.Opacity" Value="{StaticResource FluentCardPressedOpacity}" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="Disabled">
						<VisualState.Setters>
							<Setter Target="ElevatedRoot.Background" Value="{ThemeResource SurfaceVariantBrush}" />
							<Setter Target="HeaderContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
							<Setter Target="SubHeaderContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
							<Setter Target="SupportingContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
							<Setter Target="IconsContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
							<Setter Target="AvatarContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
							<Setter Target="MediaContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
						</VisualState.Setters>
					</VisualState>
				</VisualStateGroup>
				<VisualStateGroup x:Name="FocusStates">
					<VisualState x:Name="Focused" />
					<VisualState x:Name="PointerFocused" />
					<VisualState x:Name="Unfocused" />
				</VisualStateGroup>
			</VisualStateManager.VisualStateGroups>

			<toolkit:ElevatedView x:Name="ElevatedRoot"
								  Background="{TemplateBinding Background}"
								  CornerRadius="{TemplateBinding CornerRadius}"
								  Elevation="{TemplateBinding Elevation}"
								  ShadowColor="{TemplateBinding ShadowColor}">
				<Grid BorderBrush="{TemplateBinding BorderBrush}"
					  BorderThickness="{TemplateBinding BorderThickness}"
					  CornerRadius="{TemplateBinding CornerRadius}">
					<Border x:Name="InteractionOverlay"
							Background="{TemplateBinding Foreground}"
							CornerRadius="{TemplateBinding CornerRadius}"
							IsHitTestVisible="False"
							Opacity="0" />
					<Grid Padding="{TemplateBinding Padding}">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<ContentPresenter x:Name="AvatarContentPresenter"
										  Grid.Row="0"
										  Margin="{ThemeResource Space300BottomThickness}"
										  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										  Content="{TemplateBinding AvatarContent}"
										  ContentTemplate="{TemplateBinding AvatarContentTemplate}"
										  Foreground="{TemplateBinding Foreground}"
										  Visibility="{Binding AvatarContent, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyOrNullToCollapsedConverter}}" />
						<ContentPresenter x:Name="HeaderContentPresenter"
										  Grid.Row="1"
										  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										  FontFamily="{ThemeResource TitleMediumFontFamily}"
										  FontSize="{ThemeResource TitleMediumFontSize}"
										  FontWeight="{ThemeResource TitleMediumFontWeight}"
										  Content="{TemplateBinding HeaderContent}"
										  ContentTemplate="{TemplateBinding HeaderContentTemplate}"
										  Foreground="{TemplateBinding Foreground}"
										  Visibility="{Binding HeaderContent, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyOrNullToCollapsedConverter}}" />
						<ContentPresenter x:Name="SubHeaderContentPresenter"
										  Grid.Row="2"
										  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										  FontFamily="{ThemeResource BodyMediumFontFamily}"
										  FontSize="{ThemeResource BodyMediumFontSize}"
										  FontWeight="{ThemeResource BodyMediumFontWeight}"
										  Content="{TemplateBinding SubHeaderContent}"
										  ContentTemplate="{TemplateBinding SubHeaderContentTemplate}"
										  Foreground="{TemplateBinding Foreground}"
										  Visibility="{Binding SubHeaderContent, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyOrNullToCollapsedConverter}}" />
						<ContentPresenter x:Name="SupportingContentPresenter"
										  Grid.Row="3"
										  Margin="{ThemeResource Space300TopThickness}"
										  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										  FontFamily="{ThemeResource BodyMediumFontFamily}"
										  FontSize="{ThemeResource BodyMediumFontSize}"
										  FontWeight="{ThemeResource BodyMediumFontWeight}"
										  Content="{TemplateBinding SupportingContent}"
										  ContentTemplate="{TemplateBinding SupportingContentTemplate}"
										  Foreground="{TemplateBinding Foreground}"
										  Visibility="{Binding SupportingContent, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyOrNullToCollapsedConverter}}" />
						<ContentPresenter x:Name="MediaContentPresenter"
										  Grid.Row="0"
										  Grid.RowSpan="4"
										  Grid.Column="1"
										  Margin="{ThemeResource Space300LeftThickness}"
										  VerticalAlignment="Top"
										  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										  Content="{TemplateBinding MediaContent}"
										  ContentTemplate="{TemplateBinding MediaContentTemplate}"
										  Foreground="{TemplateBinding Foreground}"
										  Visibility="{Binding MediaContent, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyOrNullToCollapsedConverter}}" />
						<ContentPresenter x:Name="IconsContentPresenter"
										  Grid.Row="4"
										  Grid.ColumnSpan="2"
										  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
										  Content="{TemplateBinding IconsContent}"
										  ContentTemplate="{TemplateBinding IconsContentTemplate}"
										  Foreground="{TemplateBinding Foreground}" />
					</Grid>
				</Grid>
			</toolkit:ElevatedView>
		</Grid>
	</ControlTemplate>

	<Style x:Key="FluentBaseCardStyle"
		   TargetType="utu:Card">
		<Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
		<Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
		<Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
		<Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
		<Setter Property="Padding" Value="{ThemeResource Space400Thickness}" />
		<Setter Property="FontFamily" Value="{ThemeResource BodyMediumFontFamily}" />
		<Setter Property="FontSize" Value="{ThemeResource BodyMediumFontSize}" />
		<Setter Property="FontWeight" Value="{ThemeResource BodyMediumFontWeight}" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="VerticalContentAlignment" Value="Stretch" />
		<Setter Property="UseSystemFocusVisuals" Value="True" />
		<Setter Property="IsClickable" Value="False" />
		<Setter Property="MediaContentTemplate" Value="{StaticResource FluentDefaultMediaContentTemplate}" />
		<Setter Property="AvatarContentTemplate" Value="{StaticResource FluentDefaultAvatarContentTemplate}" />
		<Setter Property="Template" Value="{StaticResource FluentStandardCardTemplate}" />
	</Style>

	<Style x:Key="FluentFilledCardStyle"
		   BasedOn="{StaticResource FluentBaseCardStyle}"
		   TargetType="utu:Card">
		<Setter Property="BorderThickness" Value="0" />
	</Style>
	<Style x:Key="FluentOutlinedCardStyle"
		   BasedOn="{StaticResource FluentBaseCardStyle}"
		   TargetType="utu:Card">
		<Setter Property="BorderThickness" Value="{StaticResource FluentCardBorderThickness}" />
	</Style>
	<Style x:Key="FluentElevatedCardStyle"
		   BasedOn="{StaticResource FluentOutlinedCardStyle}"
		   TargetType="utu:Card">
		<Setter Property="Elevation" Value="{StaticResource FluentCardElevation}" />
	</Style>

	<Style x:Key="FluentAvatarFilledCardStyle"
		   BasedOn="{StaticResource FluentFilledCardStyle}"
		   TargetType="utu:Card">
		<Setter Property="Template" Value="{StaticResource FluentAvatarCardTemplate}" />
	</Style>

	<Style x:Key="FluentAvatarOutlinedCardStyle"
		   BasedOn="{StaticResource FluentOutlinedCardStyle}"
		   TargetType="utu:Card">
		<Setter Property="Template" Value="{StaticResource FluentAvatarCardTemplate}" />
	</Style>

	<Style x:Key="FluentAvatarElevatedCardStyle"
		   BasedOn="{StaticResource FluentElevatedCardStyle}"
		   TargetType="utu:Card">
		<Setter Property="Template" Value="{StaticResource FluentAvatarCardTemplate}" />
	</Style>

	<Style x:Key="FluentSmallMediaFilledCardStyle"
		   BasedOn="{StaticResource FluentFilledCardStyle}"
		   TargetType="utu:Card">
		<Setter Property="Template" Value="{StaticResource FluentSmallMediaCardTemplate}" />
		<Setter Property="MediaContentTemplate" Value="{StaticResource FluentDefaultSmallMediaContentTemplate}" />
	</Style>

	<Style x:Key="FluentSmallMediaOutlinedCardStyle"
		   BasedOn="{StaticResource FluentOutlinedCardStyle}"
		   TargetType="utu:Card">
		<Setter Property="Template" Value="{StaticResource FluentSmallMediaCardTemplate}" />
		<Setter Property="MediaContentTemplate" Value="{StaticResource FluentDefaultSmallMediaContentTemplate}" />
	</Style>

	<Style x:Key="FluentSmallMediaElevatedCardStyle"
		   BasedOn="{StaticResource FluentElevatedCardStyle}"
		   TargetType="utu:Card">
		<Setter Property="Template" Value="{StaticResource FluentSmallMediaCardTemplate}" />
		<Setter Property="MediaContentTemplate" Value="{StaticResource FluentDefaultSmallMediaContentTemplate}" />
	</Style>

	<Style x:Key="FluentBrandFilledCardStyle"
		   BasedOn="{StaticResource FluentFilledCardStyle}"
		   TargetType="utu:Card">
		<Setter Property="Background" Value="{ThemeResource PrimaryBrush}" />
		<Setter Property="Foreground" Value="{ThemeResource OnPrimaryBrush}" />
		<Setter Property="BorderBrush" Value="{ThemeResource PrimaryBrush}" />
	</Style>

	<Style x:Key="FluentBrandOutlinedCardStyle"
		   BasedOn="{StaticResource FluentOutlinedCardStyle}"
		   TargetType="utu:Card">
		<Setter Property="Background" Value="{ThemeResource PrimaryBrush}" />
		<Setter Property="Foreground" Value="{ThemeResource OnPrimaryBrush}" />
		<Setter Property="BorderBrush" Value="{ThemeResource PrimaryBrush}" />
	</Style>
</ResourceDictionary>
