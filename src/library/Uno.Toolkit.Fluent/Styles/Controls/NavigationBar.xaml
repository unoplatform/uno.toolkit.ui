<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:utu="using:Uno.Toolkit.UI">

	<!--
		Reuse the Toolkit command-bar presenter and its overflow and back-navigation
		contracts. Select XAML explicitly for consistent Fluent rendering on every target.
	-->
	<Thickness x:Key="FluentNavigationBarPadding">8,0</Thickness>

	<Style x:Key="FluentMainCommandStyle"
		   BasedOn="{StaticResource DefaultMainCommandStyle}"
		   TargetType="AppBarButton">
		<Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
		<!-- The native default omits its icon on mobile; the Fluent XAML presenter needs it. -->
		<Setter Property="Icon">
			<Setter.Value>
				<SymbolIcon Symbol="Back" />
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="FluentModalMainCommandStyle"
		   BasedOn="{StaticResource FluentMainCommandStyle}"
		   TargetType="AppBarButton">
		<Setter Property="Icon">
			<Setter.Value>
				<SymbolIcon Symbol="Cancel" />
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="FluentPrimaryMainCommandStyle"
		   BasedOn="{StaticResource FluentMainCommandStyle}"
		   TargetType="AppBarButton">
		<Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
	</Style>
	<Style x:Key="FluentPrimaryModalMainCommandStyle"
		   BasedOn="{StaticResource FluentModalMainCommandStyle}"
		   TargetType="AppBarButton">
		<Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
	</Style>
	<Style x:Key="FluentPrimaryAppBarButtonStyle"
		   BasedOn="{StaticResource DefaultAppBarButtonStyle}"
		   TargetType="AppBarButton">
		<Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
	</Style>

	<Style x:Key="FluentNavigationBarStyle"
		   BasedOn="{StaticResource DefaultNavigationBar}"
		   TargetType="utu:NavigationBar">
		<Setter Property="Template" Value="{StaticResource XamlNavigationBarTemplate}" />
		<Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
		<Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
		<Setter Property="Padding" Value="{ThemeResource FluentNavigationBarPadding}" />
		<Setter Property="FontFamily" Value="{ThemeResource TitleLargeFontFamily}" />
		<Setter Property="FontSize" Value="{ThemeResource TitleLargeFontSize}" />
		<Setter Property="FontWeight" Value="{ThemeResource TitleLargeFontWeight}" />
		<Setter Property="MainCommandStyle" Value="{StaticResource FluentMainCommandStyle}" />
	</Style>
	<Style x:Key="FluentModalNavigationBarStyle"
		   BasedOn="{StaticResource FluentNavigationBarStyle}"
		   TargetType="utu:NavigationBar">
		<Setter Property="MainCommandStyle" Value="{StaticResource FluentModalMainCommandStyle}" />
	</Style>
	<!-- Fluent retains a neutral command surface; primary means accent emphasis. -->
	<Style x:Key="FluentPrimaryNavigationBarStyle"
		   BasedOn="{StaticResource FluentNavigationBarStyle}"
		   TargetType="utu:NavigationBar">
		<Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
		<Setter Property="MainCommandStyle" Value="{StaticResource FluentPrimaryMainCommandStyle}" />
	</Style>
	<Style x:Key="FluentPrimaryModalNavigationBarStyle"
		   BasedOn="{StaticResource FluentPrimaryNavigationBarStyle}"
		   TargetType="utu:NavigationBar">
		<Setter Property="MainCommandStyle" Value="{StaticResource FluentPrimaryModalMainCommandStyle}" />
	</Style>
	<Style x:Key="FluentDefaultNavigationBarStyle"
		   BasedOn="{StaticResource FluentNavigationBarStyle}"
		   TargetType="utu:NavigationBar" />
	<Style x:Key="FluentDefaultMainCommandStyle"
		   BasedOn="{StaticResource FluentMainCommandStyle}"
		   TargetType="AppBarButton" />
</ResourceDictionary>
