<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:utu="using:Uno.Toolkit.UI">

	<x:Double x:Key="FluentDividerHeight">1</x:Double>

	<Style x:Key="FluentDividerStyle"
		   TargetType="utu:Divider">
		<Setter Property="Foreground" Value="{ThemeResource OutlineVariantBrush}" />
		<Setter Property="SubHeaderForeground" Value="{ThemeResource OnSurfaceVariantBrush}" />
		<Setter Property="FontFamily" Value="{ThemeResource BodyMediumFontFamily}" />
		<Setter Property="FontSize" Value="{ThemeResource BodyMediumFontSize}" />
		<Setter Property="FontWeight" Value="{ThemeResource BodyMediumFontWeight}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="utu:Divider">
					<Grid Padding="{TemplateBinding Padding}">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Rectangle Height="{StaticResource FluentDividerHeight}"
								   AutomationProperties.AccessibilityView="Raw"
								   Fill="{TemplateBinding Foreground}" />
						<TextBlock Grid.Row="1"
								   Margin="{ThemeResource Space200TopThickness}"
								   FontFamily="{TemplateBinding FontFamily}"
								   FontSize="{TemplateBinding FontSize}"
								   FontWeight="{TemplateBinding FontWeight}"
								   Foreground="{TemplateBinding SubHeaderForeground}"
								   Text="{TemplateBinding SubHeader}"
								   TextWrapping="Wrap"
								   Visibility="{Binding SubHeader, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyToCollapsedConverter}, FallbackValue=Collapsed}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<Style x:Key="FluentDefaultDividerStyle"
		   BasedOn="{StaticResource FluentDividerStyle}"
		   TargetType="utu:Divider" />
</ResourceDictionary>
