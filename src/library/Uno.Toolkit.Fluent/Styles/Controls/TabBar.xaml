<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:utu="using:Uno.Toolkit.UI">

	<x:Double x:Key="FluentTabBarMinHeight">40</x:Double>
	<x:Double x:Key="FluentBottomTabBarMinHeight">56</x:Double>
	<x:Double x:Key="FluentTabBarIconSize">16</x:Double>
	<x:Double x:Key="FluentTabBarIndicatorThickness">3</x:Double>
	<Thickness x:Key="FluentTabBarItemPadding">12,8</Thickness>
	<Thickness x:Key="FluentTabBarPadding">4</Thickness>

	<!--
		Item interaction states remain independent of the selection-indicator
		presenter so keyboard selection and animated indicator movement still work.
	-->
	<ControlTemplate x:Key="FluentTabBarItemTemplate"
					 TargetType="utu:TabBarItem">
		<Grid x:Name="Root"
			  Padding="{TemplateBinding Padding}"
			  Background="{TemplateBinding Background}"
			  BorderBrush="{TemplateBinding BorderBrush}"
			  BorderThickness="{TemplateBinding BorderThickness}"
			  CornerRadius="{TemplateBinding CornerRadius}"
			  Control.IsTemplateFocusTarget="True">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<VisualStateManager.VisualStateGroups>
				<VisualStateGroup x:Name="PointerStates">
					<VisualState x:Name="Normal" />
					<VisualState x:Name="PointerOver">
						<VisualState.Setters>
							<Setter Target="Root.Background" Value="{ThemeResource SurfaceVariantBrush}" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="Pressed">
						<VisualState.Setters>
							<Setter Target="Root.Background" Value="{ThemeResource SurfaceVariantBrush}" />
							<Setter Target="IconPresenter.Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
							<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="Selected">
						<VisualState.Setters>
							<Setter Target="Root.Background" Value="{ThemeResource SurfaceVariantBrush}" />
							<Setter Target="IconPresenter.Foreground" Value="{ThemeResource PrimaryBrush}" />
							<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource PrimaryBrush}" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="PointerOverSelected">
						<VisualState.Setters>
							<Setter Target="Root.Background" Value="{ThemeResource SurfaceVariantBrush}" />
							<Setter Target="IconPresenter.Foreground" Value="{ThemeResource PrimaryBrush}" />
							<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource PrimaryBrush}" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="PressedSelected">
						<VisualState.Setters>
							<Setter Target="Root.Background" Value="{ThemeResource SurfaceVariantBrush}" />
							<Setter Target="IconPresenter.Foreground" Value="{ThemeResource PrimaryBrush}" />
							<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource PrimaryBrush}" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="Disabled">
						<VisualState.Setters>
							<Setter Target="IconPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
							<Setter Target="ContentPresenter.Foreground" Value="{ThemeResource OnSurfaceDisabledBrush}" />
						</VisualState.Setters>
					</VisualState>
				</VisualStateGroup>
				<VisualStateGroup x:Name="TabBarIconPositionStates">
					<VisualState x:Name="IconOnTop" />
					<VisualState x:Name="IconOnly">
						<VisualState.Setters>
							<Setter Target="ContentPresenter.Visibility" Value="Collapsed" />
							<Setter Target="IconPresenter.Margin" Value="0" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="ContentOnly">
						<VisualState.Setters>
							<Setter Target="IconPresenter.Visibility" Value="Collapsed" />
						</VisualState.Setters>
					</VisualState>
				</VisualStateGroup>
			</VisualStateManager.VisualStateGroups>
			<ContentPresenter x:Name="IconPresenter"
							  Width="{ThemeResource FluentTabBarIconSize}"
							  Height="{ThemeResource FluentTabBarIconSize}"
							  Margin="0,0,8,0"
							  VerticalAlignment="Center"
							  Content="{TemplateBinding Icon}"
							  Foreground="{TemplateBinding Foreground}" />
			<ContentPresenter x:Name="ContentPresenter"
							  Grid.Column="1"
							  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
							  Content="{TemplateBinding Content}"
							  ContentTemplate="{TemplateBinding ContentTemplate}"
							  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
							  ContentTransitions="{TemplateBinding ContentTransitions}"
							  FontFamily="{TemplateBinding FontFamily}"
							  FontSize="{TemplateBinding FontSize}"
							  FontWeight="{TemplateBinding FontWeight}"
							  Foreground="{TemplateBinding Foreground}" />
			<Border Grid.Column="2"
					Margin="8,0,0,0"
					MinWidth="16"
					MinHeight="16"
					Padding="4,0"
					VerticalAlignment="Center"
					Background="{ThemeResource PrimaryBrush}"
					CornerRadius="8"
					Visibility="{TemplateBinding BadgeVisibility}">
				<TextBlock Text="{TemplateBinding BadgeValue}"
						   FontFamily="{ThemeResource CaptionMediumFontFamily}"
						   FontSize="{ThemeResource CaptionMediumFontSize}"
						   Foreground="{ThemeResource OnPrimaryBrush}"
						   HorizontalAlignment="Center" />
			</Border>
		</Grid>
	</ControlTemplate>

	<Style x:Key="FluentTopTabBarItemStyle"
		   TargetType="utu:TabBarItem">
		<Setter Property="MinHeight" Value="{ThemeResource FluentTabBarMinHeight}" />
		<Setter Property="Padding" Value="{ThemeResource FluentTabBarItemPadding}" />
		<Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
		<Setter Property="FontFamily" Value="{ThemeResource BodyMediumFontFamily}" />
		<Setter Property="FontSize" Value="{ThemeResource BodyMediumFontSize}" />
		<Setter Property="FontWeight" Value="{ThemeResource BodyMediumFontWeight}" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="UseSystemFocusVisuals" Value="True" />
		<Setter Property="Template" Value="{StaticResource FluentTabBarItemTemplate}" />
	</Style>
	<Style x:Key="FluentVerticalTabBarItemStyle"
		   BasedOn="{StaticResource FluentTopTabBarItemStyle}"
		   TargetType="utu:TabBarItem">
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
	</Style>
	<Style x:Key="FluentBottomTabBarItemStyle"
		   BasedOn="{StaticResource FluentTopTabBarItemStyle}"
		   TargetType="utu:TabBarItem">
		<Setter Property="MinHeight" Value="{ThemeResource FluentBottomTabBarMinHeight}" />
	</Style>
	<Style x:Key="FluentColoredTopTabBarItemStyle"
		   BasedOn="{StaticResource FluentTopTabBarItemStyle}"
		   TargetType="utu:TabBarItem">
		<Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
	</Style>
	<Style x:Key="FluentNavigationTabBarItemStyle"
		   BasedOn="{StaticResource FluentVerticalTabBarItemStyle}"
		   TargetType="utu:TabBarItem" />
	<!-- FAB semantic items remain command-only rather than participating in selection. -->
	<Style x:Key="FluentFabTabBarItemStyle"
		   BasedOn="{StaticResource FluentTopTabBarItemStyle}"
		   TargetType="utu:TabBarItem">
		<Setter Property="IsSelectable" Value="False" />
		<Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
	</Style>
	<Style x:Key="FluentBottomFabTabBarItemStyle"
		   BasedOn="{StaticResource FluentFabTabBarItemStyle}"
		   TargetType="utu:TabBarItem">
		<Setter Property="MinHeight" Value="{ThemeResource FluentBottomTabBarMinHeight}" />
	</Style>

	<DataTemplate x:Key="FluentHorizontalTabBarIndicatorTemplate">
		<Border Height="{ThemeResource FluentTabBarIndicatorThickness}"
				Margin="8,0"
				VerticalAlignment="Bottom"
				Background="{ThemeResource PrimaryBrush}"
				CornerRadius="2" />
	</DataTemplate>
	<DataTemplate x:Key="FluentVerticalTabBarIndicatorTemplate">
		<Border Width="{ThemeResource FluentTabBarIndicatorThickness}"
				Margin="0,8"
				HorizontalAlignment="Left"
				Background="{ThemeResource PrimaryBrush}"
				CornerRadius="2" />
	</DataTemplate>
	<Style x:Key="FluentTopTabBarStyle"
		   BasedOn="{StaticResource BaseHorizontalTabBarStyle}"
		   TargetType="utu:TabBar">
		<Setter Property="MinHeight" Value="{ThemeResource FluentTabBarMinHeight}" />
		<Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
		<Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
		<Setter Property="Padding" Value="{ThemeResource FluentTabBarPadding}" />
		<Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
		<Setter Property="ItemContainerStyle" Value="{StaticResource FluentTopTabBarItemStyle}" />
		<Setter Property="SelectionIndicatorContentTemplate" Value="{StaticResource FluentHorizontalTabBarIndicatorTemplate}" />
	</Style>
	<Style x:Key="FluentColoredTopTabBarStyle"
		   BasedOn="{StaticResource FluentTopTabBarStyle}"
		   TargetType="utu:TabBar">
		<Setter Property="ItemContainerStyle" Value="{StaticResource FluentColoredTopTabBarItemStyle}" />
	</Style>
	<Style x:Key="FluentBottomTabBarStyle"
		   BasedOn="{StaticResource FluentTopTabBarStyle}"
		   TargetType="utu:TabBar">
		<Setter Property="MinHeight" Value="{ThemeResource FluentBottomTabBarMinHeight}" />
		<Setter Property="VerticalAlignment" Value="Bottom" />
		<Setter Property="ItemContainerStyle" Value="{StaticResource FluentBottomTabBarItemStyle}" />
	</Style>
	<Style x:Key="FluentVerticalTabBarStyle"
		   BasedOn="{StaticResource BaseVerticalTabBarStyle}"
		   TargetType="utu:TabBar">
		<Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
		<Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
		<Setter Property="Padding" Value="{ThemeResource FluentTabBarPadding}" />
		<Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
		<Setter Property="ItemContainerStyle" Value="{StaticResource FluentVerticalTabBarItemStyle}" />
		<Setter Property="SelectionIndicatorContentTemplate" Value="{StaticResource FluentVerticalTabBarIndicatorTemplate}" />
	</Style>
	<Style x:Key="FluentTabBarStyle"
		   BasedOn="{StaticResource FluentTopTabBarStyle}"
		   TargetType="utu:TabBar" />
	<Style x:Key="FluentTabBarItemStyle"
		   BasedOn="{StaticResource FluentTopTabBarItemStyle}"
		   TargetType="utu:TabBarItem" />
</ResourceDictionary>
