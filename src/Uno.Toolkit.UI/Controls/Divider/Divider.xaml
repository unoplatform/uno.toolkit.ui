<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:utu="using:Uno.Toolkit.UI">

	<!-- Base style, so a Divider still renders when no design-system library (Material, Simple) styles it, e.g. with Cupertino. -->
	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Default">
			<StaticResource x:Key="DividerForeground" ResourceKey="DividerStrokeColorDefaultBrush" />
			<StaticResource x:Key="DividerSubHeaderForeground" ResourceKey="TextFillColorSecondaryBrush" />

			<StaticResource x:Key="DividerSubHeaderFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<FontWeight x:Key="DividerSubHeaderFontWeight">Normal</FontWeight>
			<x:Double x:Key="DividerSubHeaderFontSize">12</x:Double>
			<x:Int32 x:Key="DividerSubHeaderCharacterSpacing">0</x:Int32>

			<Thickness x:Key="DividerSubHeaderMargin">0,4,0,0</Thickness>
			<x:Double x:Key="DividerHeight">1</x:Double>
		</ResourceDictionary>
		<ResourceDictionary x:Key="Light">
			<StaticResource x:Key="DividerForeground" ResourceKey="DividerStrokeColorDefaultBrush" />
			<StaticResource x:Key="DividerSubHeaderForeground" ResourceKey="TextFillColorSecondaryBrush" />

			<StaticResource x:Key="DividerSubHeaderFontFamily" ResourceKey="ContentControlThemeFontFamily" />
			<FontWeight x:Key="DividerSubHeaderFontWeight">Normal</FontWeight>
			<x:Double x:Key="DividerSubHeaderFontSize">12</x:Double>
			<x:Int32 x:Key="DividerSubHeaderCharacterSpacing">0</x:Int32>

			<Thickness x:Key="DividerSubHeaderMargin">0,4,0,0</Thickness>
			<x:Double x:Key="DividerHeight">1</x:Double>
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>

	<Style x:Key="DefaultDividerStyle"
		   TargetType="utu:Divider">
		<Setter Property="Foreground" Value="{ThemeResource DividerForeground}" />
		<Setter Property="SubHeaderForeground" Value="{ThemeResource DividerSubHeaderForeground}" />
		<Setter Property="IsTabStop" Value="False" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="utu:Divider">
					<Grid>
						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="SubHeaderStates">
								<VisualState x:Name="SubHeaderCollapsed" />
								<VisualState x:Name="SubHeaderVisible">
									<VisualState.Setters>
										<Setter Target="SubHeaderTextBlock.Visibility" Value="Visible" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>

						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<Rectangle Height="{ThemeResource DividerHeight}"
								   Fill="{TemplateBinding Foreground}" />

						<TextBlock x:Name="SubHeaderTextBlock"
								   Grid.Row="1"
								   Visibility="Collapsed"
								   Margin="{ThemeResource DividerSubHeaderMargin}"
								   CharacterSpacing="{ThemeResource DividerSubHeaderCharacterSpacing}"
								   FontFamily="{ThemeResource DividerSubHeaderFontFamily}"
								   FontSize="{ThemeResource DividerSubHeaderFontSize}"
								   FontWeight="{ThemeResource DividerSubHeaderFontWeight}"
								   Foreground="{TemplateBinding SubHeaderForeground}"
								   Text="{TemplateBinding SubHeader}" />
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style BasedOn="{StaticResource DefaultDividerStyle}"
		   TargetType="utu:Divider" />
</ResourceDictionary>
