<Project ToolsVersion="15.0">
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <UnoThemesVersion>9.1.0-dev.8</UnoThemesVersion>
    <!-- Set here because the canary updater doesn't update this property. Keep it on the same C# Markup
         build as Uno Themes' Markup packages (Uno.WinUI.Markup). -->
    <UnoCSharpMarkupVersion>7.1.0-dev.5</UnoCSharpMarkupVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.14" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="1.0.0" />
    <PackageVersion Include="Uno.Core.Extensions.Collections" Version="5.0.0" />
    <PackageVersion Include="Uno.Core.Extensions.Logging.Singleton" Version="5.0.0" />
    <PackageVersion Include="Uno.Core.Extensions.Logging" Version="5.0.0" />
    <PackageVersion Include="Uno.SourceGenerationTasks" Version="4.2.0" />
    <PackageVersion Include="Uno.XamlMerge.Task" Version="1.34.0-dev.3" />
    <PackageVersion Include="FluentAssertions" Version="5.10.3" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.4.1" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageVersion Include="NUnit" Version="3.14.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.2.0" />
    <PackageVersion Include="NunitXml.TestLogger" Version="3.0.131" />
    <PackageVersion Include="Uno.UI.RuntimeTests.Engine" Version="3.0.0-dev.16" />
    <PackageVersion Include="Uno.WinUI.DevServer" Version="7.1.0-dev.478" />
    <PackageVersion Include="Uno.UITest" Version="1.1.0-dev.82" />
    <PackageVersion Include="Uno.UITest.Helpers" Version="1.1.0-dev.82" />
    <PackageVersion Include="Uno.UITest.Selenium" Version="1.1.0-dev.82" />
    <PackageVersion Include="Uno.UITest.Xamarin" Version="1.1.0-dev.82" />
    <PackageVersion Include="Xamarin.UITest" Version="4.4.0" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.3.3" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="9.0.0" />
    <PackageVersion Include="Uno.Simple.WinUI" Version="$(UnoThemesVersion)" />
    <PackageVersion Include="Uno.Themes.WinUI" Version="$(UnoThemesVersion)" />
  </ItemGroup>
</Project>
