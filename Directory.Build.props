<Project>
	<Import Project="$(MSBuildThisFileDirectory)src/CrossTargeting.props" />

	<PropertyGroup>
		<UnoEnableXamlFuzzyMatching>false</UnoEnableXamlFuzzyMatching>
		<!-- Required by uno 7.0 (WinRT.Runtime.dll >= 2.3.1); the .NET SDK default (10.0.19041.57) ships 2.2.0.
		     A minimum revision, like Uno.Sdk 7.0 sets itself (unoplatform/uno#25836): WindowsSdkPackageVersion
		     next to it fails with NETSDK1230 (unoplatform/uno#26174). -->
		<WindowsSdkPackageMinimumRevision Condition="'$(WindowsSdkPackageVersion)'=='' and '$(WindowsSdkPackageMinimumRevision)'==''">87</WindowsSdkPackageMinimumRevision>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup>
		<Build_Android>true</Build_Android>
		<Build_iOS>true</Build_iOS>
		<Build_Windows Condition="'$(OS)'=='Windows_NT'">true</Build_Windows>
		<Build_Windows Condition="'$(OS)'!='Windows_NT'">false</Build_Windows>
	</PropertyGroup>
</Project>
