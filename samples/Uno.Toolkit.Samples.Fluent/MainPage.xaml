<Page x:Class="Uno.Toolkit.Samples.Fluent.MainPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:utu="using:Uno.Toolkit.UI"
	  Background="{ThemeResource BackgroundBrush}">
	<Grid RowDefinitions="Auto,*">
		<utu:NavigationBar Content="Fluent Toolkit"
						   Style="{StaticResource NavigationBarStyle}">
			<utu:NavigationBar.PrimaryCommands>
				<AppBarButton Label="Theme"
							  Icon="Switch"
							  Click="OnSwitchTheme" />
			</utu:NavigationBar.PrimaryCommands>
		</utu:NavigationBar>
		<ScrollViewer Grid.Row="1">
			<StackPanel MaxWidth="960"
						Margin="24"
						Spacing="20">
				<TextBlock Text="Toolkit controls, Fluent design"
						   Style="{StaticResource HeadlineMedium}" />
				<TextBlock Text="Switch between light and dark using the theme button. All examples use semantic style keys."
						   TextWrapping="Wrap"
						   Style="{StaticResource BodyMedium}" />
				<utu:TabBar Style="{StaticResource TopTabBarStyle}">
					<utu:TabBarItem Content="Overview"
									IsSelected="True" />
					<utu:TabBarItem Content="Activity" />
					<utu:TabBarItem Content="Settings" />
				</utu:TabBar>
				<TextBlock Text="Chips"
						   Style="{StaticResource TitleLarge}" />
				<utu:ChipGroup Style="{StaticResource FilterChipGroupStyle}"
							   SelectionMode="Multiple">
					<utu:Chip Content="Design"
							  IsChecked="True" />
					<utu:Chip Content="Development" />
					<utu:Chip Content="Testing" />
				</utu:ChipGroup>
				<StackPanel Orientation="Horizontal"
							Spacing="8">
					<utu:Chip Content="Suggestion"
							  Style="{StaticResource SuggestionChipStyle}" />
					<utu:Chip Content="Removable"
							  Style="{StaticResource InputChipStyle}"
							  Removed="OnChipRemoved" />
					<utu:Chip Content="Disabled"
							  Style="{StaticResource AssistChipStyle}"
							  IsEnabled="False" />
					<utu:Chip Content="Danger"
							  Style="{StaticResource DangerChipStyle}" />
				</StackPanel>
				<utu:Divider Style="{StaticResource DividerStyle}" />
				<TextBlock Text="Cards"
						   Style="{StaticResource TitleLarge}" />
				<utu:Card Style="{StaticResource OutlinedCardStyle}"
						  HeaderContent="Project workspace"
						  SubHeaderContent="Fluent surfaces and typography"
						  SupportingContent="Related content is grouped using a subtle outline and rounded corners.">
					<utu:Card.IconsContent>
						<Button Content="Open project"
								Style="{StaticResource FilledButtonStyle}" />
					</utu:Card.IconsContent>
				</utu:Card>
				<utu:CardContentControl Style="{StaticResource FilledCardContentControlStyle}">
					<StackPanel Spacing="8">
						<TextBlock Text="Custom card content"
								   Style="{StaticResource TitleMedium}" />
						<TextBlock Text="Use CardContentControl for your own layout."
								   TextWrapping="Wrap" />
					</StackPanel>
				</utu:CardContentControl>
				<TextBlock Text="Loading and layout"
						   Style="{StaticResource TitleLarge}" />
				<utu:LoadingView Style="{StaticResource LoadingViewStyle}"
								 Height="72" />
				<utu:ResponsiveView Style="{StaticResource ResponsiveViewStyle}">
					<utu:ResponsiveView.NormalTemplate>
						<DataTemplate>
							<TextBlock Text="Responsive content keeps the host theme." />
						</DataTemplate>
					</utu:ResponsiveView.NormalTemplate>
				</utu:ResponsiveView>
				<utu:TabBar Style="{StaticResource BottomTabBarStyle}">
					<utu:TabBarItem Content="Home"
									IsSelected="True">
						<utu:TabBarItem.Icon>
							<SymbolIcon Symbol="Home" />
						</utu:TabBarItem.Icon>
					</utu:TabBarItem>
					<utu:TabBarItem Content="Favorites">
						<utu:TabBarItem.Icon>
							<SymbolIcon Symbol="Favorite" />
						</utu:TabBarItem.Icon>
					</utu:TabBarItem>
				</utu:TabBar>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</Page>
