<Page x:Class="Uno.Toolkit.Samples.Content.Controls.FlexPanelSamplePage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:local="using:Uno.Toolkit.Samples.Content.Controls"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:utu="using:Uno.Toolkit.UI"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:sample="using:Uno.Toolkit.Samples"
	  mc:Ignorable="d"
	  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

	<Page.Resources>
		<SolidColorBrush x:Key="FlexDemoHostBorderBrush" Color="#80808080" />
		<SolidColorBrush x:Key="FlexDemoItemBrush" Color="#5B8DEF" />
		<SolidColorBrush x:Key="FlexDemoItemAltBrush" Color="#67E5AD" />
		<SolidColorBrush x:Key="FlexDemoItemWarnBrush" Color="#F2994A" />
		<SolidColorBrush x:Key="FlexDemoItemForeground" Color="#101418" />

		<!-- Caption above each specimen. -->
		<Style x:Key="FlexCaptionStyle"
			   BasedOn="{StaticResource BodyTextBlockStyle}"
			   TargetType="TextBlock">
			<Setter Property="Margin" Value="0,24,0,4" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>

		<!-- FlexPanel is a Panel and cannot draw its own border, so every specimen is wrapped. -->
		<Style x:Key="FlexHostStyle" TargetType="Border">
			<Setter Property="BorderBrush" Value="{StaticResource FlexDemoHostBorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
		</Style>

		<Style x:Key="FlexItemStyle" TargetType="Border">
			<Setter Property="Background" Value="{StaticResource FlexDemoItemBrush}" />
			<Setter Property="Padding" Value="12,8" />
			<Setter Property="CornerRadius" Value="4" />
		</Style>

		<Style x:Key="FlexItemTextStyle" TargetType="TextBlock">
			<Setter Property="Foreground" Value="{StaticResource FlexDemoItemForeground}" />
			<Setter Property="FontSize" Value="13" />
		</Style>
	</Page.Resources>

	<Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
		<sample:SamplePageLayout x:Name="SamplePageLayout" IsDesignAgnostic="True">
			<sample:SamplePageLayout.DesignAgnosticTemplate>
				<DataTemplate>
					<ScrollViewer HorizontalScrollMode="Disabled">
						<StackPanel Margin="0,0,0,32">

							<!-- 1. Intro -->
							<TextBlock Margin="0,24,0,0"
									   TextWrapping="Wrap"
									   Text="FlexPanel lays out its children using CSS Flexbox semantics, backed by the Yoga layout engine. Reach for it when you want flexbox rules — grow/shrink distribution, wrapping lines, gaps and per-item alignment. Reach for AutoLayout when you want Figma auto-layout parity instead."
									   Style="{StaticResource BodyTextBlockStyle}" />

							<Button Margin="0,16,0,0"
									AutomationProperties.AutomationId="FlexPanel_Launch_Playground_Button"
									Click="LaunchPlayground"
									Content="Open the interactive playground" />

							<!-- 2. Bare FlexPanel — the Direction-default canary. -->
							<TextBlock Text="A bare FlexPanel. Direction defaults to Row, so these lay out horizontally." Style="{StaticResource FlexCaptionStyle}" />
							<Border Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel x:Name="BareFlexPanel"
											   ColumnGap="8"
											   Padding="8">
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="One" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="Two" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="Three" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<!-- 3. Direction -->
							<TextBlock Margin="0,32,0,0"
									   Text="Direction"
									   Style="{StaticResource TitleTextBlockStyle}" />
							<TextBlock Text="Row (default)" Style="{StaticResource FlexCaptionStyle}" />
							<Border Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel ColumnGap="8"
											   Direction="Row"
											   Padding="8">
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="1" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="2" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="3" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="RowReverse" Style="{StaticResource FlexCaptionStyle}" />
							<Border Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel ColumnGap="8"
											   Direction="RowReverse"
											   Padding="8">
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="1" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="2" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="3" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="Column" Style="{StaticResource FlexCaptionStyle}" />
							<Border Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel AlignItems="FlexStart"
											   Direction="Column"
											   Padding="8"
											   RowGap="8">
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="1" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="2" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="3" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="ColumnReverse" Style="{StaticResource FlexCaptionStyle}" />
							<Border Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel AlignItems="FlexStart"
											   Direction="ColumnReverse"
											   Padding="8"
											   RowGap="8">
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="1" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="2" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="3" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<!-- 4. JustifyContent — main-axis distribution. -->
							<TextBlock Margin="0,32,0,0"
									   Text="JustifyContent"
									   Style="{StaticResource TitleTextBlockStyle}" />
							<TextBlock Margin="0,4,0,0"
									   TextWrapping="Wrap"
									   Text="Distributes children along the main axis. FlexJustify carries extra members for engine parity; only the six below produce distinct layouts."
									   Style="{StaticResource BodyTextBlockStyle}" />

							<TextBlock Text="FlexStart (default)" Style="{StaticResource FlexCaptionStyle}" />
							<Border Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel AlignItems="Center"
											   ColumnGap="8"
											   JustifyContent="FlexStart"
											   Padding="8">
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="A" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="B" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="C" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="Center" Style="{StaticResource FlexCaptionStyle}" />
							<Border Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel AlignItems="Center"
											   ColumnGap="8"
											   JustifyContent="Center"
											   Padding="8">
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="A" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="B" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="C" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="FlexEnd" Style="{StaticResource FlexCaptionStyle}" />
							<Border Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel AlignItems="Center"
											   ColumnGap="8"
											   JustifyContent="FlexEnd"
											   Padding="8">
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="A" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="B" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="C" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="SpaceBetween" Style="{StaticResource FlexCaptionStyle}" />
							<Border Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel AlignItems="Center"
											   ColumnGap="8"
											   JustifyContent="SpaceBetween"
											   Padding="8">
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="A" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="B" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="C" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="SpaceAround" Style="{StaticResource FlexCaptionStyle}" />
							<Border Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel AlignItems="Center"
											   ColumnGap="8"
											   JustifyContent="SpaceAround"
											   Padding="8">
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="A" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="B" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="C" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="SpaceEvenly" Style="{StaticResource FlexCaptionStyle}" />
							<Border Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel AlignItems="Center"
											   ColumnGap="8"
											   JustifyContent="SpaceEvenly"
											   Padding="8">
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="A" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="B" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="C" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<!-- 5. AlignItems — cross-axis alignment. -->
							<TextBlock Margin="0,32,0,0"
									   Text="AlignItems"
									   Style="{StaticResource TitleTextBlockStyle}" />
							<TextBlock Margin="0,4,0,0"
									   TextWrapping="Wrap"
									   Text="Aligns children on the cross axis. The host is given a fixed height so there is cross-axis space to distribute."
									   Style="{StaticResource BodyTextBlockStyle}" />

							<TextBlock Text="Stretch (default)" Style="{StaticResource FlexCaptionStyle}" />
							<Border Height="110" Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel AlignItems="Stretch"
											   ColumnGap="8"
											   Padding="8">
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="A" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Background="{StaticResource FlexDemoItemAltBrush}" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="B" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="FlexStart" Style="{StaticResource FlexCaptionStyle}" />
							<Border Height="110" Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel AlignItems="FlexStart"
											   ColumnGap="8"
											   Padding="8">
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="A" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Background="{StaticResource FlexDemoItemAltBrush}" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="B" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="Center" Style="{StaticResource FlexCaptionStyle}" />
							<Border Height="110" Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel AlignItems="Center"
											   ColumnGap="8"
											   Padding="8">
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="A" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Background="{StaticResource FlexDemoItemAltBrush}" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="B" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="FlexEnd" Style="{StaticResource FlexCaptionStyle}" />
							<Border Height="110" Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel AlignItems="FlexEnd"
											   ColumnGap="8"
											   Padding="8">
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="A" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Background="{StaticResource FlexDemoItemAltBrush}" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="B" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="Baseline — text of different sizes sits on a shared baseline." Style="{StaticResource FlexCaptionStyle}" />
							<Border Height="110" Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel AlignItems="Baseline"
											   ColumnGap="12"
											   Padding="8">
									<TextBlock FontSize="12" Text="12pt" />
									<TextBlock FontSize="24" Text="24pt" />
									<TextBlock FontSize="36" Text="36pt" />
									<TextBlock FontSize="18" Text="18pt" />
								</utu:FlexPanel>
							</Border>

							<!-- 6. Wrap and gaps -->
							<TextBlock Margin="0,32,0,0"
									   Text="Wrap, ColumnGap and RowGap"
									   Style="{StaticResource TitleTextBlockStyle}" />
							<TextBlock Margin="0,4,0,0"
									   TextWrapping="Wrap"
									   Text="ColumnGap is the gutter along the main axis, RowGap between wrapped lines. Negative gaps are clamped to 0 by the engine — use a negative child Margin for overlap instead."
									   Style="{StaticResource BodyTextBlockStyle}" />

							<TextBlock Text="NoWrap (default) — items shrink rather than wrap." Style="{StaticResource FlexCaptionStyle}" />
							<Border Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel ColumnGap="8"
											   Padding="8"
											   Wrap="NoWrap">
									<Border Width="160" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="160" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="160" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="160" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="160" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="160" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="160" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="160" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="160" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="160" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="Wrap — with ColumnGap 8 and RowGap 8." Style="{StaticResource FlexCaptionStyle}" />
							<Border Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel ColumnGap="8"
											   Padding="8"
											   RowGap="8"
											   Wrap="Wrap">
									<Border Width="160" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="1" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="160" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="2" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="160" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="3" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="160" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="4" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="160" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="5" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="160" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="6" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="WrapReverse — lines stack in the opposite cross-axis order." Style="{StaticResource FlexCaptionStyle}" />
							<Border Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel ColumnGap="8"
											   Padding="8"
											   RowGap="8"
											   Wrap="WrapReverse">
									<Border Width="160" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="1" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="160" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="2" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="160" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="3" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="160" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="4" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="160" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="5" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="160" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="6" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<!-- 7. AlignContent — only meaningful with wrapping and spare cross-axis room. -->
							<TextBlock Margin="0,32,0,0"
									   Text="AlignContent"
									   Style="{StaticResource TitleTextBlockStyle}" />
							<TextBlock Margin="0,4,0,0"
									   TextWrapping="Wrap"
									   Text="Distributes the wrapped lines themselves along the cross axis. It requires Wrap and more than one line — with a single line it does nothing."
									   Style="{StaticResource BodyTextBlockStyle}" />

							<TextBlock Text="FlexStart (default)" Style="{StaticResource FlexCaptionStyle}" />
							<Border Height="200" Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel AlignContent="FlexStart"
											   ColumnGap="8"
											   Padding="8"
											   RowGap="8"
											   Wrap="Wrap">
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="1" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="2" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="3" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="4" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="Center" Style="{StaticResource FlexCaptionStyle}" />
							<Border Height="200" Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel AlignContent="Center"
											   ColumnGap="8"
											   Padding="8"
											   RowGap="8"
											   Wrap="Wrap">
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="1" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="2" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="3" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="4" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="FlexEnd" Style="{StaticResource FlexCaptionStyle}" />
							<Border Height="200" Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel AlignContent="FlexEnd"
											   ColumnGap="8"
											   Padding="8"
											   RowGap="8"
											   Wrap="Wrap">
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="1" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="2" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="3" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="4" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="Stretch" Style="{StaticResource FlexCaptionStyle}" />
							<Border Height="200" Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel AlignContent="Stretch"
											   ColumnGap="8"
											   Padding="8"
											   RowGap="8"
											   Wrap="Wrap">
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="1" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="2" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="3" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="4" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="SpaceBetween" Style="{StaticResource FlexCaptionStyle}" />
							<Border Height="200" Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel AlignContent="SpaceBetween"
											   ColumnGap="8"
											   Padding="8"
											   RowGap="8"
											   Wrap="Wrap">
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="1" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="2" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="3" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="4" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="SpaceAround" Style="{StaticResource FlexCaptionStyle}" />
							<Border Height="200" Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel AlignContent="SpaceAround"
											   ColumnGap="8"
											   Padding="8"
											   RowGap="8"
											   Wrap="Wrap">
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="1" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="2" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="3" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="4" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="SpaceEvenly" Style="{StaticResource FlexCaptionStyle}" />
							<Border Height="200" Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel AlignContent="SpaceEvenly"
											   ColumnGap="8"
											   Padding="8"
											   RowGap="8"
											   Wrap="Wrap">
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="1" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="2" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="3" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Width="180" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="4" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<!-- 8. Grow / Shrink / Basis -->
							<TextBlock Margin="0,32,0,0"
									   Text="Grow, Shrink and Basis"
									   Style="{StaticResource TitleTextBlockStyle}" />

							<TextBlock Text="App shell: a fixed title, a spacer with Grow=1 that absorbs the slack, and trailing buttons." Style="{StaticResource FlexCaptionStyle}" />
							<Border Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel AlignItems="Center"
											   ColumnGap="8"
											   Padding="8">
									<TextBlock utu:FlexPanel.Shrink="0"
											   FontSize="16"
											   Text="MyApp"
											   Style="{StaticResource FlexItemTextStyle}" />
									<Border utu:FlexPanel.Grow="1" />
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="Share" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="Settings" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="Grow=1 alone: only the LEFTOVER space is shared, so items with different content stay different widths." Style="{StaticResource FlexCaptionStyle}" />
							<Border Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel ColumnGap="8" Padding="8">
									<Border utu:FlexPanel.Grow="1" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="Short" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border utu:FlexPanel.Grow="1"
											Background="{StaticResource FlexDemoItemAltBrush}"
											Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="Considerably longer content" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border utu:FlexPanel.Grow="1"
											Background="{StaticResource FlexDemoItemWarnBrush}"
											Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="Mid length" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="Grow=1 with Basis=0 — the CSS `flex: 1 1 0` shorthand. THIS is equal columns: content size is taken out of the equation." Style="{StaticResource FlexCaptionStyle}" />
							<Border Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel ColumnGap="8" Padding="8">
									<Border utu:FlexPanel.Basis="0"
											utu:FlexPanel.Grow="1"
											Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="Short" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border utu:FlexPanel.Basis="0"
											utu:FlexPanel.Grow="1"
											Background="{StaticResource FlexDemoItemAltBrush}"
											Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="Considerably longer content" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border utu:FlexPanel.Basis="0"
											utu:FlexPanel.Grow="1"
											Background="{StaticResource FlexDemoItemWarnBrush}"
											Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="Mid length" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="Grow ratio 1:2 — the second item receives twice the leftover space of the first." Style="{StaticResource FlexCaptionStyle}" />
							<Border Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel ColumnGap="8" Padding="8">
									<Border utu:FlexPanel.Basis="0"
											utu:FlexPanel.Grow="1"
											Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="Grow 1" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border utu:FlexPanel.Basis="0"
											utu:FlexPanel.Grow="2"
											Background="{StaticResource FlexDemoItemAltBrush}"
											Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="Grow 2" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="Shrink: the row overflows, but only the first item has Shrink=1, so it absorbs the whole deficit." Style="{StaticResource FlexCaptionStyle}" />
							<Border Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel ColumnGap="8" Padding="8">
									<Border utu:FlexPanel.Shrink="1"
											Width="400"
											Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="Shrink 1" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border utu:FlexPanel.Shrink="0"
											Background="{StaticResource FlexDemoItemAltBrush}"
											Width="400"
											Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="Shrink 0" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<!-- 9. Absolute positioning -->
							<TextBlock Margin="0,32,0,0"
									   Text="Absolute positioning"
									   Style="{StaticResource TitleTextBlockStyle}" />
							<TextBlock Text="Position=Absolute takes the badge out of the flow: it is placed by its insets and the two flowed items are laid out as if it were not there." Style="{StaticResource FlexCaptionStyle}" />
							<Border Height="120" Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel ColumnGap="8" Padding="8">
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="Flowed A" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="Flowed B" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border utu:FlexPanel.Bottom="10"
											utu:FlexPanel.Position="Absolute"
											utu:FlexPanel.Right="10"
											Background="{StaticResource FlexDemoItemWarnBrush}"
											Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="Absolute (right 10, bottom 10)" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<!-- 10. LayoutDirection -->
							<TextBlock Margin="0,32,0,0"
									   Text="LayoutDirection"
									   Style="{StaticResource TitleTextBlockStyle}" />
							<TextBlock Margin="0,4,0,0"
									   TextWrapping="Wrap"
									   Text="LayoutDirection is the only right-to-left input FlexPanel reads — FlowDirection is ignored. Setting both to a right-to-left value mirrors the layout twice, which is almost never what you want."
									   Style="{StaticResource BodyTextBlockStyle}" />

							<TextBlock Text="LeftToRight (default)" Style="{StaticResource FlexCaptionStyle}" />
							<Border Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel ColumnGap="8"
											   LayoutDirection="LeftToRight"
											   Padding="8">
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="First" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Background="{StaticResource FlexDemoItemAltBrush}" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="Second" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Background="{StaticResource FlexDemoItemWarnBrush}" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="Third" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="RightToLeft — the main axis starts on the right." Style="{StaticResource FlexCaptionStyle}" />
							<Border Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel ColumnGap="8"
											   LayoutDirection="RightToLeft"
											   Padding="8">
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="First" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Background="{StaticResource FlexDemoItemAltBrush}" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="Second" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Background="{StaticResource FlexDemoItemWarnBrush}" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="Third" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<!-- 11. Padding and the automatic minimum size -->
							<TextBlock Margin="0,32,0,0"
									   Text="Padding and FlexMinWidth"
									   Style="{StaticResource TitleTextBlockStyle}" />
							<TextBlock Margin="0,4,0,0"
									   TextWrapping="Wrap"
									   Text="By default a flex item will not shrink below its min-content size (CSS Flexbox section 4.5). Setting FlexMinWidth to 0 opts out of that floor and lets the text be clipped instead."
									   Style="{StaticResource BodyTextBlockStyle}" />

							<TextBlock Text="Padding 24,16 on the panel itself." Style="{StaticResource FlexCaptionStyle}" />
							<Border Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel ColumnGap="8" Padding="24,16">
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="A" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="B" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="Default auto minimum — the long label refuses to shrink past its min-content width." Style="{StaticResource FlexCaptionStyle}" />
							<Border Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel ColumnGap="8" Padding="8">
									<Border Width="600" Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="An intentionally long single line of text that would rather not be squeezed"
												   TextTrimming="CharacterEllipsis"
												   Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border utu:FlexPanel.Shrink="0"
											Background="{StaticResource FlexDemoItemAltBrush}"
											Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="Fixed" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

							<TextBlock Text="FlexMinWidth=0 — the same row, opted out of the floor, so the label shrinks and trims." Style="{StaticResource FlexCaptionStyle}" />
							<Border Style="{StaticResource FlexHostStyle}">
								<utu:FlexPanel ColumnGap="8" Padding="8">
									<Border utu:FlexPanel.FlexMinWidth="0"
											Width="600"
											Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="An intentionally long single line of text that would rather not be squeezed"
												   TextTrimming="CharacterEllipsis"
												   Style="{StaticResource FlexItemTextStyle}" />
									</Border>
									<Border utu:FlexPanel.Shrink="0"
											Background="{StaticResource FlexDemoItemAltBrush}"
											Style="{StaticResource FlexItemStyle}">
										<TextBlock Text="Fixed" Style="{StaticResource FlexItemTextStyle}" />
									</Border>
								</utu:FlexPanel>
							</Border>

						</StackPanel>
					</ScrollViewer>
				</DataTemplate>
			</sample:SamplePageLayout.DesignAgnosticTemplate>
		</sample:SamplePageLayout>
	</Grid>
</Page>
