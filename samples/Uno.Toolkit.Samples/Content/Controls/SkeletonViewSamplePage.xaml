<Page x:Class="Uno.Toolkit.Samples.Content.Controls.SkeletonViewSamplePage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:local="using:Uno.Toolkit.Samples.Content.Controls"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:utu="using:Uno.Toolkit.UI"
	  xmlns:sample="using:Uno.Toolkit.Samples"
	  mc:Ignorable="d"
	  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

	<Page.Resources>
		<DataTemplate x:Key="PersonRowTemplate">
			<StackPanel Margin="0,6"
						Orientation="Horizontal"
						Spacing="12">
				<Ellipse Width="40"
						 Height="40"
						 Fill="{ThemeResource SystemControlHighlightAccentBrush}" />
				<StackPanel VerticalAlignment="Center"
							Spacing="4">
					<TextBlock Text="{Binding Name}" />
					<TextBlock FontSize="12"
							   Text="{Binding Title}" />
				</StackPanel>
			</StackPanel>
		</DataTemplate>
	</Page.Resources>

	<sample:SamplePageLayout x:Name="SamplePageLayout"
							 IsDesignAgnostic="True">
		<sample:SamplePageLayout.DesignAgnosticTemplate>
			<DataTemplate>
				<ScrollViewer>
					<StackPanel Padding="16"
								Spacing="24">

						<!-- Section 1: auto-generated skeleton from the real content -->
						<TextBlock Style="{StaticResource TitleTextBlockStyle}"
								   Text="Auto-generated skeleton" />
						<TextBlock Text="The placeholders below are generated from the actual content layout — no skeleton shapes are declared."
								   TextWrapping="Wrap" />

						<ToggleSwitch IsOn="{Binding Data.IsLoading, Mode=TwoWay}"
									  OffContent="Loaded"
									  OnContent="Loading" />

						<utu:SkeletonView IsLoading="{Binding Data.IsLoading}">
							<StackPanel Spacing="12">
								<StackPanel Orientation="Horizontal"
											Spacing="12">
									<Ellipse Width="48"
											 Height="48"
											 Fill="{ThemeResource SystemControlHighlightAccentBrush}" />
									<StackPanel VerticalAlignment="Center"
												Spacing="4">
										<TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
												   Text="{Binding Data.Title}" />
										<TextBlock Style="{StaticResource CaptionTextBlockStyle}"
												   Text="{Binding Data.Subtitle}" />
									</StackPanel>
								</StackPanel>
								<TextBlock Text="{Binding Data.Description}"
										   TextWrapping="Wrap" />
								<Button Content="Some action" />
							</StackPanel>
						</utu:SkeletonView>

						<!-- Section 2: driven by an ILoadable source -->
						<TextBlock Margin="0,16,0,0"
								   Style="{StaticResource TitleTextBlockStyle}"
								   Text="Driven by an ILoadable" />

						<Button Command="{Binding Data.LoadDataCommand}"
								Content="Reload data" />

						<utu:SkeletonView Source="{Binding Data.LoadDataCommand}">
							<StackPanel Spacing="8">
								<TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
										   Text="{Binding Data.Title}" />
								<TextBlock Text="{Binding Data.Description}"
										   TextWrapping="Wrap" />
							</StackPanel>
						</utu:SkeletonView>

						<!-- Section 3: overrides -->
						<TextBlock Margin="0,16,0,0"
								   Style="{StaticResource TitleTextBlockStyle}"
								   Text="Overrides" />
						<TextBlock Text="A static header is excluded with Skeleton.Ignore; a square image is forced into a circle with Skeleton.Shape."
								   TextWrapping="Wrap" />

						<utu:SkeletonView EnableShimmer="False"
										  IsLoading="{Binding Data.IsLoading}">
							<StackPanel Spacing="12">
								<TextBlock utu:Skeleton.Ignore="True"
										   Style="{StaticResource SubtitleTextBlockStyle}"
										   Text="Always visible header" />
								<StackPanel Orientation="Horizontal"
											Spacing="12">
									<Border utu:Skeleton.Shape="Circle"
											Width="64"
											Height="64"
											Background="{ThemeResource SystemControlHighlightAccentBrush}" />
									<TextBlock VerticalAlignment="Center"
											   Text="{Binding Data.Subtitle}" />
								</StackPanel>
							</StackPanel>
						</utu:SkeletonView>

						<!-- Section 4: template-driven skeleton (SkeletonPresenter) -->
						<TextBlock Margin="0,16,0,0"
								   Style="{StaticResource TitleTextBlockStyle}"
								   Text="Template-driven (SkeletonPresenter)" />
						<TextBlock Text="The same DataTemplate that renders real list items also drives the skeleton — empty list controls are stamped with placeholder rows. This is what utu:Skeleton.IsEnabled injects as a FeedView's ProgressTemplate."
								   TextWrapping="Wrap" />

						<utu:SkeletonPresenter utu:Skeleton.PlaceholderCount="3"
											   MaxHeight="220">
							<utu:SkeletonPresenter.ContentTemplate>
								<DataTemplate>
									<ListView ItemTemplate="{StaticResource PersonRowTemplate}" />
								</DataTemplate>
							</utu:SkeletonPresenter.ContentTemplate>
						</utu:SkeletonPresenter>

					</StackPanel>
				</ScrollViewer>
			</DataTemplate>
		</sample:SamplePageLayout.DesignAgnosticTemplate>
	</sample:SamplePageLayout>

</Page>
