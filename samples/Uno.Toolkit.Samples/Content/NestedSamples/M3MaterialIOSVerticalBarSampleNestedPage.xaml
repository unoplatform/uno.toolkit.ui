<Page x:Class="Uno.Toolkit.Samples.Content.NestedSamples.M3MaterialIOSVerticalBarSampleNestedPage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	  xmlns:utu="using:Uno.Toolkit.UI"
	  mc:Ignorable="d"
	  Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Left and Right keep the NavigationBar out of the vertical bar strip -->
		<utu:NavigationBar Content="iOS Vertical Bar Sample Page"
						   Style="{StaticResource MaterialNavigationBarStyle}"
						   MainCommandMode="Action"
						   utu:SafeArea.Insets="Left,Top,Right">
			<utu:NavigationBar.MainCommand>
				<AppBarButton Style="{StaticResource MaterialAppBarButtonStyle}"
							  Click="NavigateBack">
					<AppBarButton.Icon>
						<BitmapIcon UriSource="ms-appx:///Assets/CloseIcon.png"
									ShowAsMonochrome="False" />
					</AppBarButton.Icon>
				</AppBarButton>
			</utu:NavigationBar.MainCommand>
		</utu:NavigationBar>

		<StackPanel Grid.Row="1"
					Padding="16"
					Spacing="8"
					VerticalAlignment="Center"
					utu:SafeArea.Insets="Left,Right">
			<TextBlock Text="On iOS 27.1 devices that show a vertical bar, such as the iPhone Duo cover screen, the tabs move into the strip at the side of the screen. Elsewhere, the bottom TabBar is shown."
					   TextWrapping="Wrap"
					   Style="{StaticResource BodyLarge}" />
			<StackPanel Orientation="Horizontal"
						Spacing="4">
				<TextBlock Text="Selected tab index:"
						   Style="{StaticResource TitleMedium}" />
				<TextBlock Text="{Binding SelectedIndex, ElementName=BottomTabBar}"
						   Style="{StaticResource TitleMedium}" />
			</StackPanel>
		</StackPanel>

		<!-- Default: bottom TabBar -->
		<utu:TabBar x:Name="BottomTabBar"
					Grid.Row="2"
					SelectedIndex="0"
					Style="{StaticResource BottomTabBarStyle}">
			<utu:TabBarItem Content="Home">
				<utu:TabBarItem.Icon>
					<SymbolIcon Symbol="Home" />
				</utu:TabBarItem.Icon>
			</utu:TabBarItem>
			<utu:TabBarItem Content="Search">
				<utu:TabBarItem.Icon>
					<SymbolIcon Symbol="Find" />
				</utu:TabBarItem.Icon>
			</utu:TabBarItem>
			<utu:TabBarItem Content="Library">
				<utu:TabBarItem.Icon>
					<SymbolIcon Symbol="Library" />
				</utu:TabBarItem.Icon>
			</utu:TabBarItem>
			<utu:TabBarItem Content="Settings">
				<utu:TabBarItem.Icon>
					<SymbolIcon Symbol="Setting" />
				</utu:TabBarItem.Icon>
			</utu:TabBarItem>
		</utu:TabBar>

		<!-- iOS vertical bar: icon-only TabBar inside the strip, placed from code -->
		<Grid x:Name="VerticalBarHost"
			  Grid.RowSpan="3"
			  VerticalAlignment="Bottom"
			  Visibility="Collapsed"
			  utu:SafeArea.Insets="Bottom">
			<Border Margin="8"
					CornerRadius="32"
					Background="{ThemeResource SurfaceBrush}">
				<!-- The vertical TabBar fills the height it gets, so size it to its items -->
				<utu:TabBar Height="240"
							MinWidth="0"
							Padding="0,8"
							Background="Transparent"
							SelectedIndex="{Binding SelectedIndex, ElementName=BottomTabBar, Mode=TwoWay}"
							Style="{StaticResource VerticalTabBarStyle}"
							utu:SafeArea.Insets="None">
					<utu:TabBarItem>
						<utu:TabBarItem.Icon>
							<SymbolIcon Symbol="Home" />
						</utu:TabBarItem.Icon>
					</utu:TabBarItem>
					<utu:TabBarItem>
						<utu:TabBarItem.Icon>
							<SymbolIcon Symbol="Find" />
						</utu:TabBarItem.Icon>
					</utu:TabBarItem>
					<utu:TabBarItem>
						<utu:TabBarItem.Icon>
							<SymbolIcon Symbol="Library" />
						</utu:TabBarItem.Icon>
					</utu:TabBarItem>
					<utu:TabBarItem>
						<utu:TabBarItem.Icon>
							<SymbolIcon Symbol="Setting" />
						</utu:TabBarItem.Icon>
					</utu:TabBarItem>
				</utu:TabBar>
			</Border>
		</Grid>
	</Grid>
</Page>
