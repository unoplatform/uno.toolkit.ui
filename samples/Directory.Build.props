<Project>
	<Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

		<!--
		  Adding NoWarn to remove build warnings
		  NU1507: Warning when there are multiple package sources when using CPM with no source mapping
		  NETSDK1201: Warning that specifying RID won't create self containing app
		  PRI257: Ignore default language (en) not being one of the included resources (eg en-us, en-uk)
		-->
		<NoWarn>$(NoWarn);NU1507;NETSDK1201;PRI257</NoWarn>

		<!--
		  The SDK adds Uno.UI.HotDesign and Uno.UI.App.Mcp to Debug heads, and neither has an Uno 7 build yet:
		  both bind Uno 6 assemblies (Uno, Uno.UI.Toolkit), which fails compilation with CS0012.
		  Hot Design also depends on the Uno.Toolkit.WinUI package, which these heads build from source.
		-->
		<UnoDisableHotDesign>true</UnoDisableHotDesign>
		<UnoDisableMCPSupport>true</UnoDisableMCPSupport>
	</PropertyGroup>

	<!--
	  MSTest.TestFramework 4.x (pulled in by the hosted Uno.Toolkit.RuntimeTests) adds a global
	  `using Microsoft.VisualStudio.TestTools.UnitTesting` to every consumer with ImplicitUsings.
	  The sample code does not use MSTest, and the using makes [Description] ambiguous with
	  System.ComponentModel. Removed in a target because the package adds it after this file is evaluated.
	-->
	<Target Name="_RemoveMSTestImplicitUsing" BeforeTargets="GenerateGlobalUsings">
		<ItemGroup>
			<Using Remove="Microsoft.VisualStudio.TestTools.UnitTesting" />
		</ItemGroup>
	</Target>
</Project>
